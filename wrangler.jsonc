{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tech-week-agent",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-08",
  "minify": true,
  "assets": {
    "directory": "./public"
  },
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMIT",
      "namespace_id": "98026091401",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
